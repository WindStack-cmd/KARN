# .env.example
# Example environment configuration for KARN project
# -------------------------------------------------
# FastAPI CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API key for protected endpoints (optional, leave empty for no auth)
API_KEY=your_api_key_here

# Vite frontend API URL (used by frontend during development)
VITE_API_URL=http://127.0.0.1:8000/api
